# ============================================================
# Supabase 연결 환경변수
# 아래 값은 Supabase 대시보드 > 해당 프로젝트 > Project Settings > API 에서 확인합니다.
# ============================================================

# Project URL (예: https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — 브라우저(클라이언트)에서 사용, RLS로 보호됨
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 서버(관리자 API 라우트 등)에서만 사용, RLS를 우회하므로 절대 브라우저에 노출 금지
# 이 프로젝트의 기본 코드는 사용하지 않지만, 배치 작업/관리자 스크립트 등에서 필요할 수 있어 남겨둡니다.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# 지도 SDK (선택 — 지도 기능을 사용할 때만 필요)
# ============================================================

# 카카오맵 JavaScript SDK 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 네이버지도 클라이언트 ID (NAVER Cloud Platform > AI·NAVER API > Application)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
